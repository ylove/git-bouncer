{
  "name": "git-bouncer",
  "version": "1.0.0",
  "description": "Don't just git clone. A door check for repos you didn't write: ID check, sandboxed pat-down, then a verdict before anything touches your machine.",
  "keywords": [
    "security",
    "supply-chain-security",
    "git",
    "git-clone",
    "sandbox",
    "docker",
    "podman",
    "malware",
    "typosquatting",
    "devsecops",
    "cli"
  ],
  "type": "module",
  "bin": {
    "bouncer": "bin/bouncer.js",
    "git-bouncer": "bin/git-bouncer.js"
  },
  "files": [
    "bin/",
    "src/",
    "sandbox/",
    "LICENSE",
    "NOTICE",
    "README.md",
    "SECURITY.md",
    "THREAT_MODEL.md",
    "docs/"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test"
  },
  "author": "Yitz Jordan (https://github.com/ylove)",
  "homepage": "https://ylove.github.io/git-bouncer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ylove/git-bouncer.git"
  },
  "bugs": {
    "url": "https://github.com/ylove/git-bouncer/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
