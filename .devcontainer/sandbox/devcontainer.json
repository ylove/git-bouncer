// The sandbox Codespace used by `bouncer --runtime codespace` (and automatically when there's no
// local Docker or Podman). The Codespace is created from THIS repository with THIS file, never from
// the repo being checked: a suspect repo's own devcontainer.json could run commands at creation time,
// with a GitHub token present.
//
// Deliberately boring: the standard Codespaces image pinned by digest, and no features, lifecycle
// commands (postCreateCommand etc.), mounts, secrets, ports or extensions.
{
  "name": "git-bouncer sandbox",
  "image": "mcr.microsoft.com/devcontainers/universal:2@sha256:dca6a985ffbbc74007a13b6f56ac0fbbc5febae081350b66e865a5549338134b"
}
